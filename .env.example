# Copy this file to .env and fill in what you need. .env stays on your laptop (it's in .gitignore).
# Tracking + dashboard need NOTHING from this file. After editing, restart: .\workpulse stop  then  .\workpulse start

# Where WorkPulse keeps its SQLite DB, logs and pause flag (default: ./data)
# WORKPULSE_DATA_DIR=

# Use a different config file (default: ./config.yaml)
# WORKPULSE_CONFIG=

# --- AI coach (optional). Without it, WorkPulse uses plain message templates. ---
# Get a key at https://platform.claude.com/ (API keys). Usage is billed per token.
ANTHROPIC_API_KEY=

# --- WhatsApp via the Twilio sandbox (README → "WhatsApp setup") ---
# Console → Account info: Account SID + Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox number Twilio shows you (this is the standard one)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# YOUR WhatsApp number with country code. The bot only ever talks to this number.
MY_WHATSAPP_NUMBER=whatsapp:+91XXXXXXXXXX

# --- Later: Meta WhatsApp Cloud API instead of Twilio (set whatsapp.provider: meta in config.yaml) ---
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=pick-any-long-random-string

# Normalize line endings in the repository; check out with the platform's native endings.
* text=auto
# Unix scripts must keep LF to run on macOS/Linux.
android/gradlew text eol=lf
*.sh text eol=lf
# Windows scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
# Binary files
*.png binary
*.ico binary
*.jar binary
